    "kind": "play",
    "id": "ru.playsoftware.j2meloader",
    "official": true
   },
   {
    "kind": "fdroid",
    "id": "ru.playsoftware.j2meloader",
    "official": true
   },
   {
    "kind": "github",
    "repo": "nikita36078/J2ME-Loader",
    "official": true
   },
   {
    "kind": "github",
    "repo": "nikita36078/J2ME-Loader",
    "channel": "nightly",
    "official": true
   }
  ],
  "source": "nikita36078/J2ME-Loader README.md: the Google Play and F-Droid badges, the releases badge, and 'Automated builds' (releases/tag/continuous)"
 }
}

 "label": "J2ME Loader (Standalone)",
 "pkg": "ru.playsoftware.j2meloader",
 "argumentsTemplate": "-n ru.playsoftware.j2meloader/ru.playsoftware.j2meloader.MainActivity --activity-clear-task --activity-clear-top -d {file.uri}",
 "killPackageProcesses": false,
 "install": {
  "v": 1,
  "sources": [

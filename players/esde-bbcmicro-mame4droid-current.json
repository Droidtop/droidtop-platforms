{
 "id": "esde-bbcmicro-mame4droid-current",
 "systemId": "bbcmicro",
 "label": "MAME4droid Current (Standalone)",
 "pkg": "com.seleuco.mame4d2024",
 "argumentsTemplate": "-n com.seleuco.mame4d2024/com.seleuco.mame4droid.MAME4droid -a android.intent.action.VIEW -e cli_params \"-rompath '{file.dir};{system.folder}' -autoboot_delay '2' -autoboot_command '*cat\\n\\n*exec !boot\\n' -analogue acornjoy -flop1 '{file.path}'\" -d bbcb",
 "killPackageProcesses": false
}

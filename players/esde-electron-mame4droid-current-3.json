{
 "id": "esde-electron-mame4droid-current-3",
 "systemId": "electron",
 "label": "MAME4droid Current [Diskette ADFS] (Standalone)",
 "pkg": "com.seleuco.mame4d2024",
 "argumentsTemplate": "-n com.seleuco.mame4d2024/com.seleuco.mame4droid.MAME4droid -a android.intent.action.VIEW -e cli_params \"-rompath '{file.dir};{system.folder}' -exp plus3 -exp:plus3:fdc:1 35dd -autoboot_delay '2' -autoboot_command '*CAT\\n\\n\\n\\n\\n\\n*RUN !BOOT\\n' -flop1 '{file.path}'\" -d electron64",
 "killPackageProcesses": false
}

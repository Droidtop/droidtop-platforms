   },
   {
    "kind": "fdroid",
    "id": "com.foobnix.pro.pdf.reader",
    "official": true
   },
   {
    "kind": "github",
    "repo": "foobnix/LibreraReader",
    "official": true
   }
  ],
  "source": "foobnix/LibreraReader README.md: 'Librera PRO on Google Play', 'Librera F-Droid' (packages/com.foobnix.pro.pdf.reader) and the GitHub releases link"
 }
}

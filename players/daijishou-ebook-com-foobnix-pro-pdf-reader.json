 "label": "ebook - Librera Reader Pro",
 "pkg": "com.foobnix.pro.pdf.reader",
 "argumentsTemplate": "-n com.foobnix.pro.pdf.reader/com.foobnix.OpenerActivity -d {file.path}",
 "killPackageProcesses": true,
 "install": {
  "v": 1,
  "sources": [
   {
    "kind": "play",

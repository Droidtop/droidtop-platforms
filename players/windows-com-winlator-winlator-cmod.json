{
 "id": "windows-com-winlator-winlator-cmod",
 "systemId": "windows",
 "label": "Winlator CMod",
 "pkg": "com.winlator",
 "argumentsTemplate": "-n com.winlator/.XServerDisplayActivity -e shortcut_path {file.path} --activity-clear-task --activity-clear-top --activity-no-history",
 "killPackageProcesses": true,
 "install": {
  "v": 1,
  "sources": [
   {
    "kind": "github",
    "repo": "brunodev85/winlator",
    "official": true
   }
  ],
  "source": "brunodev85/winlator README.md, Installation: 'Download and install the APK (Winlator_11.2.apk) from GitHub Releases'"
 }
}

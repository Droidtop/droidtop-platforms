{
 "id": "esde-psx-duckstation",
 "systemId": "psx",
 "label": "DuckStation (Standalone)",
 "pkg": "com.github.stenzek.duckstation",
 "argumentsTemplate": "-n com.github.stenzek.duckstation/com.github.stenzek.duckstation.EmulationActivity --activity-clear-task --activity-clear-top --ez resumeState false -e bootPath {file.uri}",
 "storagePathTemplate": "-n com.github.stenzek.duckstation/com.github.stenzek.duckstation.EmulationActivity --activity-clear-task --activity-clear-top --ez resumeState false -e bootPath {file.path}",
 "killPackageProcesses": false,
 "install": {
  "v": 1,
  "sources": [
   {
    "kind": "play",
    "id": "com.github.stenzek.duckstation",
    "official": true
   }
  ],
  "source": "stenzek/duckstation README.md, Android: 'Download from Google Play'"
 }
}
